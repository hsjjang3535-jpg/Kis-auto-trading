# ── KIS API (한국투자증권) ──────────────────────────────────────
KIS_APP_KEY=여기에_앱키
KIS_APP_SECRET=여기에_앱시크릿
KIS_MODE=모의
KIS_ACCOUNT_NO=계좌번호(-없이, 모의는 50xxxxxxxx)
# 또는 분리 입력:
# KIS_CANO=50123456
# KIS_ACNT_PRDT_CD=01

# ── AI / 알림 ───────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
# 선택: 쉼표 구분 모델 (기본 openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.6-27b)
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
NAVER_CLIENT_ID=네이버_검색_API_ID
NAVER_CLIENT_SECRET=네이버_검색_API_SECRET
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=본인_chat_id

# ── 상태 저장 (Railway Volume 권장) ─────────────────────────────────
# Railway: Volume을 /data에 마운트 후 DATA_DIR=/data
# 미설정 시 재배포마다 trading_state·주간손익 장부가 초기화됨
DATA_DIR=.

# ── 자금 관리 ───────────────────────────────────────────────────
MAX_TOTAL_AMOUNT=2000000
MAX_BUY_AMOUNT=1000000
MAX_BUY_CASH_FAILS=3
MAX_CLOSING_AMOUNT=500000
MAX_CLOSING_BUY=500000
CLOSING_BET_MAX_PER_SLOT=1
CLOSING_BET_MAX_POSITIONS=1
# Railway 상태 유실 시 지정 종가베팅 복구 (코드|종목명|매수일|복구만료일, 여러 개는 쉼표)
CLOSING_RECOVERY_POSITIONS=042700|한미반도체|2026-07-15|2026-07-29,004310|현대약품|2026-07-16|2026-07-30
# CLOSING_ACCOUNT_SYNC=false
# CLOSING_HOLD_EXCLUDE=
# true여도 MAX_BUY/TOTAL 상한은 넘지 않음 (예수금이 작을 때만 축소)
DYNAMIC_CAPITAL=true
BUY_RATIO=1.0

# ── 지수필터 (약세장 신규매수 차단) ─────────────────────────────
ENABLE_MARKET_FILTER=true
MARKET_FILTER_KOSDAQ_MIN=-0.5
MARKET_FILTER_KOSPI_MIN=-1.0
MARKET_FILTER_REQUIRE=any
MARKET_FILTER_BLOCK_CLOSING=true
MARKET_FILTER_CACHE_SEC=60

# ── 방어모드 (연속손절·일/주 손실 → 신규매수 중단) ─────────────
ENABLE_DEFENSE_MODE=true
DEFENSE_MAX_CONSEC_LOSSES=2
DEFENSE_DAILY_LOSS_LIMIT=-40000
DEFENSE_WEEKLY_LOSS_LIMIT=-50000
DEFENSE_BLOCK_CLOSING=true

# ── 매매 규칙 ───────────────────────────────────────────────────
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=3.0
TRAILING_STOP_PCT=1.0
# 장중 강제청산: 14:00 이전 매수 → 14:50 / 14:00 이후 매수 → 15:10
LATE_INTRADAY_ENTRY_AFTER=14:00
INTRADAY_FORCE_CLOSE=14:50
LATE_INTRADAY_FORCE_CLOSE=15:10
SELL_BLACKLIST=한미사이언스
MAX_WATCHLIST=15

# ── 스크리너 완화 (장중매매, 선택) ───────────────────────────────
MIN_CHANGE_RATE=-2.0
VOL_RATIO_MIN=1.2
W52_GAP_UPPER_MAX=10.0
W52_GAP_LOWER_MAX=25.0
# 상단매매 MA5 이격 상한 (기본 15 — 과열 추격 완화)
UPPER_MA5_GAP_MAX=15.0
# 돌파매매 — 안전(고가 근접+MA5이격) / 모멘텀(장초 소액, 둘 다면 안전 우선)
BREAKOUT_HIGH20_MAX_PCT=3.0
BREAKOUT_MA5_GAP_MAX=10.0
BREAKOUT_MOMENTUM_ENABLED=true
BREAKOUT_MOMENTUM_START=09:10
BREAKOUT_MOMENTUM_END=10:30
BREAKOUT_MOMENTUM_BUY_RATIO=0.5
BREAKOUT_MOMENTUM_HIGH20_MAX_PCT=8.0
BREAKOUT_MOMENTUM_MA5_GAP_MAX=20.0
BREAKOUT_MOMENTUM_5MIN_VOL=1.5
# 장중 매수 직전 5분봉 확인 (양봉·상승·거래량)
ENTRY_5MIN_CONFIRM=true
ENTRY_5MIN_VOLUME_RATIO=1.0
UPPER_TAIL_MAX=0.35
# 장중 빠른 손절 (매수 후 N분 이내, 그 이후는 STOP_LOSS_PCT)
QUICK_STOP_LOSS_PCT=1.5
QUICK_STOP_WINDOW_MIN=30
CLOSING_BET_MIN_RATE=2.0
CLOSING_BET_MAX_RATE=10.0
CLOSING_BET_MIN_CLOSE_NEAR_HIGH=0.70
CLOSING_BET_REQUIRE_PREV_HIGH=true
CLOSING_BET_REQUIRE_MA20=true
CLOSING_BET_MAX_UPPER_TAIL=0.35
CLOSING_BET_MIN_VOL=1.5
CLOSING_BET_RSI_MIN=40
CLOSING_BET_RSI_MAX=72
CLOSING_BET_ENTRY_START=14:45
CLOSING_BET_ENTRY_END=14:50
CLOSING_STOP_LOSS_PCT=2.0
CLOSING_TRAIL_START_PCT=4.0
CLOSING_TRAIL_DROP_PCT=2.0
CLOSING_FORCE_EXIT=15:00
CLOSING_BET_OVERHEAT_RSI=72
CLOSING_BET_TRY_TOP_N=2
# 전일 워치리스트는 익일 15:10에 가상손익(−손절/트레일/종가) 알림
LOWER_RSI_MAX=50

# ── 장중매매 AI (true=Groq 2차 필터, false=기술조건만; 종가베팅 AI는 항상 ON) ──
ENABLE_INTRADAY_AI=true

# ── 낙폭반등 단타 (기본 OFF — true 시에만 동작, 모의투자에서는 자동 OFF) ──
ENABLE_CRASH_BOUNCE=false
CRASH_BOUNCE_ENTRY_START=09:10
CRASH_BOUNCE_ENTRY_END=10:30
CRASH_BOUNCE_TIME_EXIT=11:00
CRASH_BOUNCE_AFTERNOON_TIME_EXIT=14:20
CRASH_BOUNCE_AFTERNOON_VOLUME_RATIO=1.2
CRASH_BOUNCE_MIN_DROP=3.5
CRASH_BOUNCE_MAX_DROP=7.0
MAX_CRASH_BOUNCE_AMOUNT=500000
MAX_CRASH_BOUNCE_BUY=500000
CRASH_BOUNCE_MAX_POSITIONS=1
CRASH_BOUNCE_MAX_API_CALLS=20
CRASH_BOUNCE_TAKE_PROFIT=3.0
CRASH_BOUNCE_STOP_LOSS=2.0
CRASH_BOUNCE_MA_TOLERANCE=0.5
CRASH_BOUNCE_SCAN_TOP=20
CRASH_BOUNCE_MAX_CHART_CHECKS=5
# 낙폭반등 시뮬 (실전 매수 중단 시 ENABLE_CRASH_BOUNCE=false + 아래 true)
ENABLE_CRASH_BOUNCE_SIM=false
CRASH_BOUNCE_SIM_AMOUNT=500000
CRASH_BOUNCE_SIM_POLL_INTERVAL=5
CRASH_BOUNCE_SIM_POSITION_POLL=1

# 삼성전자 전용 시뮬 (기존 자동매매 유지 + 추가 테스트)
ENABLE_SAMSUNG_SIM=false
SAMSUNG_SIM_CODE=005930
SAMSUNG_SIM_NAME=삼성전자
SAMSUNG_SIM_ENTRY_START=09:00
SAMSUNG_SIM_ENTRY_END=15:00
SAMSUNG_SIM_EXIT_END=15:00
SAMSUNG_SIM_AMOUNT=500000
SAMSUNG_SIM_SCAN_INTERVAL=3
SAMSUNG_SIM_POSITION_POLL=1
SAMSUNG_SIM_MAX_API_CALLS=6
SAMSUNG_SIM_MIN_RSI=50
SAMSUNG_SIM_BREAKOUT_DAYS=20
SAMSUNG_SIM_MIN_VOLUME_RATIO=1.1
SAMSUNG_SIM_VOLUME_AVG_DAYS=5
SAMSUNG_SIM_STOP_LOSS=2.0
SAMSUNG_SIM_TAKE_PROFIT=3.0
SAMSUNG_SIM_TRAILING_STOP=0.6

# 시노펙스 전용 시뮬 (일봉 S거래량급증 + B10단기돌파)
ENABLE_SYNOPEX_SIM=false
SYNOPEX_SIM_CODE=025320
SYNOPEX_SIM_NAME=시노펙스
SYNOPEX_SIM_ENABLE_VOL_SPIKE=true
SYNOPEX_SIM_ENABLE_B10=true
SYNOPEX_SIM_ENTRY_START=09:00
SYNOPEX_SIM_ENTRY_END=15:00
SYNOPEX_SIM_EXIT_END=15:00
SYNOPEX_SIM_AMOUNT=500000
SYNOPEX_SIM_SCAN_INTERVAL=3
SYNOPEX_SIM_POSITION_POLL=1
SYNOPEX_SIM_MAX_API_CALLS=6
SYNOPEX_SIM_VOL_SPIKE_DAY_PCT=3.0
SYNOPEX_SIM_VOL_SPIKE_VOL_DAYS=20
SYNOPEX_SIM_VOL_SPIKE_VOL_RATIO=2.0
SYNOPEX_SIM_VOL_SPIKE_MAX_RSI=75
SYNOPEX_SIM_B10_DAYS=10
SYNOPEX_SIM_B10_VOL_DAYS=5
SYNOPEX_SIM_B10_VOL_RATIO=1.5
SYNOPEX_SIM_B10_MIN_RSI=45
SYNOPEX_SIM_B10_MAX_RSI=70
SYNOPEX_SIM_STOP_LOSS=2.0
SYNOPEX_SIM_TAKE_PROFIT=3.0
SYNOPEX_SIM_TRAILING_STOP=0.6

# ── V자반등 단타 (기본 OFF — true 시에만 동작) ───────────────────
ENABLE_V_REVERSAL=false
V_REVERSAL_ENTRY_START=09:15
V_REVERSAL_ENTRY_END=10:30
V_REVERSAL_TIME_EXIT=14:20
V_REVERSAL_AFTERNOON_VOLUME_RATIO=1.2
V_REVERSAL_MIN_PREV_RATE=1.0
V_REVERSAL_MIN_DROP=2.0
V_REVERSAL_MAX_BELOW_PREV=1.0
MAX_V_REVERSAL_AMOUNT=500000
MAX_V_REVERSAL_BUY=500000
V_REVERSAL_MAX_POSITIONS=1
V_REVERSAL_MAX_API_CALLS=20
V_REVERSAL_TAKE_PROFIT=3.0
V_REVERSAL_TRAILING_STOP=1.0
V_REVERSAL_STOP_LOSS=2.0
V_REVERSAL_MA_TOLERANCE=0.5
V_REVERSAL_SCAN_TOP=30
V_REVERSAL_MAX_CHART_CHECKS=5

# ── 강세주 급락 V 시뮬 (기본 OFF — true 시에만 동작, 실제 주문 없음) ─────
ENABLE_STRONG_V_SIM=false
STRONG_V_SCAN_START=09:00
STRONG_V_ENTRY_START=09:15
STRONG_V_ENTRY_END=14:30
STRONG_V_FAST_SCAN_END=10:00
STRONG_V_POLL_INTERVAL=5
STRONG_V_FAST_SCAN_INTERVAL=2
STRONG_V_FOCUS_INTERVAL=1
STRONG_V_EXIT_END=14:50
STRONG_V_TIME_EXIT=14:20
STRONG_V_MIN_PREV_RATE=2.0
STRONG_V_MIN_DROP=3.0
STRONG_V_MAX_BELOW_PREV=5.0
STRONG_V_MA5_TOLERANCE=3.0
STRONG_V_MIN_TRADING_VALUE=10000000000
STRONG_V_SIM_AMOUNT=500000
STRONG_V_MAX_API_CALLS=20
STRONG_V_TAKE_PROFIT=3.0
STRONG_V_TRAILING_STOP=1.0
STRONG_V_STOP_LOSS=2.0
STRONG_V_MA_TOLERANCE=0.5
STRONG_V_MA_EXIT=false
STRONG_V_SCAN_TOP=30
STRONG_V_MAX_CHART_CHECKS=5

# ── 상한가 리바운드 (1단계: 알림만, 자동 매매 없음) ─────────────────
ENABLE_UL_REBOUND=false
UL_REBOUND_MONITOR_START=09:00
UL_REBOUND_MONITOR_END=15:30
UL_REBOUND_MIN_TRADING_VALUE=50000000000
UL_REBOUND_WINDOW_DAYS=7
UL_REBOUND_FORCE_SELL_DAY=4
UL_REBOUND_SCAN_TOP=30
UL_REBOUND_MAX_API_CALLS=25
UL_REBOUND_MAX_CHART_CHECKS=8
UL_REBOUND_MIN_HISTORY_DAYS=2
UL_REBOUND_LEVEL_TOLERANCE=0.5
UL_REBOUND_SIM_ENABLED=true
UL_REBOUND_SIM_AMOUNT=500000

# ── K1 종가베팅 (신규 매수 비활성 — 금요일도 AI 종가와 동일) ──────────────
# 기존 K1 보유분만 4일차 청산. 새 ENABLE 해도 금요일 실전 매수는 하지 않음.
ENABLE_K1_CLOSING=false
K1_CLOSING_ENTRY_START=14:20
K1_CLOSING_ENTRY_END=14:50
K1_MIN_TRADING_VALUE=50000000000
K1_MAX_BUY_DAYS_AFTER_UL=2
K1_FORCE_SELL_DAY=4
K1_SCAN_TOP=30
K1_MAX_API_CALLS=25
K1_MAX_CHART_CHECKS=8
K1_LEVEL_TOLERANCE=0.5
K1_SIM_ENABLED=true
K1_SIM_AMOUNT=500000

# ── K2 장중 (시뮬만 — 실전 주문 없음) ────────────────────────────────
ENABLE_K2_SIM=false
K2_MONITOR_START=09:10
K2_MONITOR_END=14:45
K2_MIN_TRADING_VALUE=50000000000
K2_MAX_DAYS_FROM_HIGH=4
K2_FORCE_SELL_DAY=4
K2_SCAN_TOP=20
K2_MAX_API_CALLS=20
K2_MAX_CHART_CHECKS=5
K2_MAX_WATCH=5
K2_LEVEL_TOLERANCE=0.5
K2_SIM_AMOUNT=500000

# ── K1플러스 (시뮬만 — 세력봉 당일, 실전 주문 없음) ─────────────
ENABLE_K1_PLUS_SIM=false
# true=모니터 중 K1 훼손 즉시 매수 / false=아래 종가창만
K1_PLUS_IMMEDIATE_ON_BREACH=true
K1_PLUS_ENTRY_START=14:20
K1_PLUS_ENTRY_END=14:50
K1_PLUS_MONITOR_START=09:10
K1_PLUS_MONITOR_END=14:50
K1_PLUS_MIN_TRADING_VALUE=50000000000
K1_PLUS_MIN_DAY_RATE=5.0
K1_PLUS_FORCE_SELL_DAY=4
K1_PLUS_SCAN_TOP=20
K1_PLUS_MAX_API_CALLS=20
K1_PLUS_MAX_CHART_CHECKS=5
K1_PLUS_MAX_WATCH=5
K1_PLUS_LEVEL_TOLERANCE=0.5
K1_PLUS_SIM_AMOUNT=500000
K1_PLUS_REQUIRE_NEW_HIGH=true
K1_PLUS_STOP_LOSS_PCT=5.0
K1_PLUS_MAX_RISK_TO_LOW_PCT=8.0

# ── K2플러스 (시뮬만 — 세력봉 D1~D4 K2훼손, 실전 주문 없음) ─────
ENABLE_K2_PLUS_SIM=false
K2_PLUS_MONITOR_START=09:10
K2_PLUS_MONITOR_END=14:45
K2_PLUS_MIN_TRADING_VALUE=50000000000
K2_PLUS_MIN_DAY_RATE=5.0
K2_PLUS_MAX_DAYS_FROM_HIGH=4
K2_PLUS_FORCE_SELL_DAY=4
K2_PLUS_SCAN_TOP=20
K2_PLUS_MAX_API_CALLS=20
K2_PLUS_MAX_CHART_CHECKS=5
K2_PLUS_MAX_WATCH=5
K2_PLUS_LEVEL_TOLERANCE=0.5
K2_PLUS_SIM_AMOUNT=500000
K2_PLUS_REQUIRE_NEW_HIGH=true

# ── API 서버 (telegram-gemini-bot 연동용, 선택) ─────────────────
API_SECRET=임의_비밀문자열
PORT=8080
